{
  "name": "@felipedsvit/s3node",
  "version": "0.1.11",
  "description": "Embeddable, S3-compatible object storage server for Node.js",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "s3node": "dist/bin/s3node.js",
    "s3node-backup": "dist/bin/s3node-backup.js"
  },
  "files": [
    "dist",
    "docs",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "pretest:interop": "npm run build",
    "test:interop": "node test/interop/aws-sdk.mjs",
    "test:interop:matrix": "npm run build && node test/interop/client-matrix.mjs",
    "test:soak": "node tools/soak.mjs",
    "test:soak:smoke": "node tools/soak.mjs --duration-seconds 10 --concurrency 2",
    "prepublishOnly": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/bin/s3node.js"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "s3",
    "s3-compatible",
    "object-storage",
    "storage",
    "sigv4"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipedsvit/s3node.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
