{
  "name": "@felipedsvit/s3node",
  "version": "0.1.2",
  "description": "Embeddable, S3-compatible object storage server for Node.js",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "s3node": "bin/s3node.js"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "test:interop": "node test/interop/aws-sdk.mjs",
    "start": "node bin/s3node.js"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0"
  },
  "keywords": [
    "s3",
    "s3-compatible",
    "object-storage",
    "storage",
    "sigv4"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipedsvit/s3node.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
